{
  "name": "junglegamingtest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "npm run dev",
    "build": "npm run lint && tsc && vite build",
    "postbuild": "node scripts/prepare-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --import ./tests/register-typescript.mjs --test tests/gameplay.test.mjs",
    "dev": "vite",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:e2e:mobile": "playwright test --project=chromium-mobile --project=chromium-mobile-landscape",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "build:profile": "vite build --mode profile --outDir .profile-build",
    "profile": "node scripts/profile.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "pixi.js": "^8.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "lil-gui": "^0.21.0",
    "msw": "^2.15.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
